# Supabase — Project Settings > API on a fresh Supabase project
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auth
JWT_SECRET=change-me-to-something-long-and-random
ADMIN_KEY=change-me-admin-passcode

# Locks down which origins can call the API. Leave blank in local dev.
# In production (Render), set this to your real domain, e.g.:
# CORS_ORIGIN=https://shalakasi.onrender.com
CORS_ORIGIN=

# Satoshi (optional at first — app runs without it, falls back to
# rule-based routing and a placeholder chat reply until this is set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

PORT=3300

# Self-hosted database (see deploy/README.md). When POSTGREST_URL is set, the app uses it instead of SUPABASE_URL.
# POSTGREST_URL=http://127.0.0.1:3401
# BOOKS_DIR=/opt/shalakasi/books

# Attendance tracker link (optional). The tracker is told when a student logs in.
# TRACKER_URL=http://127.0.0.1:3920
# TRACKER_KEY=<same value as STACK_INTEGRATION_KEY in the tracker's .env>

# Study pace: most new sections a student can start per week, and the Monday the limit and the centre rotation begin.
# SECTIONS_PER_WEEK=3
# STUDY_WEEK1_START=2026-11-02
